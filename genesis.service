# Genesis Protocol - Systemd Service for Autonomous Mode
# Install: sudo cp genesis.service /etc/systemd/system/ && sudo systemctl enable genesis

[Unit]
Description=Genesis Protocol AI Bot - Autonomous Mode
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Genesis-protocol-
Environment="PATH=/home/ubuntu/Genesis-protocol-/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PORT=5000"
Environment="AUTONOMOUS_MODE=true"
ExecStart=/home/ubuntu/Genesis-protocol-/.venv/bin/python /home/ubuntu/Genesis-protocol-/scripts/autonomous_mode.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/genesis/genesis.log
StandardError=append:/var/log/genesis/genesis.err

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/ubuntu/Genesis-protocol-/data /var/log/genesis

[Install]
WantedBy=multi-user.target