# Genesis Protocol Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# TELEGRAM CONFIGURATION
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=Genesis_autonomousbot

# ============================================
# AI PROVIDER API KEYS
# ============================================

# Groq (Primary - Recommended for speed)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (2nd Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (3rd Fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace (Final Fallback)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ============================================
# VECTOR DATABASE & MEMORY
# ============================================
VECTOR_DB_TYPE=chroma
CHROMA_DB_PATH=./data/chroma_db
VECTOR_DIMENSIONS=1536
VECTOR_SIMILARITY_THRESHOLD=0.75

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=86400

# ============================================
# EXTERNAL INTEGRATIONS
# ============================================

# Tavily Search (Real-time web search)
TAVILY_API_KEY=your_tavily_api_key_here

# Make.com Webhook
MAKE_COM_WEBHOOK_URL=your_make_webhook_url_here
MAKE_COM_API_KEY=your_make_api_key_here

# HuggingFace Inference
HF_INFERENCE_ENDPOINT=https://api-inference.huggingface.co/models/

# ============================================
# STT/TTS PROVIDERS
# ============================================
WHISPER_API_KEY=
ELEVENLABS_API_KEY=
GTTS_ENABLED=true

# ============================================
# APPLICATION CONFIGURATION
# ============================================
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-secure-random-string

# ============================================
# RATE LIMITS & QUOTAS
# ============================================
MAX_MESSAGES_PER_MINUTE=20
MAX_MESSAGES_PER_HOUR=500
MAX_IMAGE_SIZE_MB=10
MAX_VOICE_DURATION_SECONDS=120
MAX_CONVERSATION_HISTORY=100

# ============================================
# CORS & SECURITY
# ============================================
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000
API_RATE_LIMIT=100

# ============================================
# STREAMLIT DASHBOARD
# ============================================
STREAMLIT_PORT=8501
STREAMLIT_SECRET_KEY=change-this-to-a-secure-random-string
ENABLE_STREAMLIT=true

# ============================================
# DEPLOYMENT
# ============================================
DEPLOYMENT_TARGET=docker
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=genesis-protocol
DOCKER_IMAGE_TAG=latest