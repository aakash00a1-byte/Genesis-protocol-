# Genesis Protocol Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# TELEGRAM CONFIGURATION
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=Genesis_autonomousbot

# ============================================
# DISCORD CONFIGURATION
# ============================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ============================================
# AI PROVIDER API KEYS
# ============================================

# Groq (Primary - Fastest)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Mistral
MISTRAL_API_KEY=your_mistral_api_key_here

# Cohere
COHERE_API_KEY=your_cohere_api_key_here

# Perplexity
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Fireworks AI
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Together AI
TOGETHER_API_KEY=your_together_api_key_here

# AI21 Jurassic
AI21_API_KEY=your_ai21_api_key_here

# HuggingFace
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Ollama (Local - No API key needed)
OLLAMA_ENDPOINT=http://localhost:11434/api/chat

# ============================================
# VECTOR DATABASE & MEMORY
# ============================================
VECTOR_DB_TYPE=chroma
CHROMA_DB_PATH=./data/chroma_db
VECTOR_DIMENSIONS=1536
VECTOR_SIMILARITY_THRESHOLD=0.75

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=86400

# ============================================
# EXTERNAL INTEGRATIONS
# ============================================

# Tavily Search (Real-time web search)
TAVILY_API_KEY=your_tavily_api_key_here

# Make.com Webhook
MAKE_COM_WEBHOOK_URL=your_make_webhook_url_here
MAKE_COM_API_KEY=your_make_api_key_here

# HuggingFace Inference
HF_INFERENCE_ENDPOINT=https://api-inference.huggingface.co/models/

# ============================================
# STT/TTS PROVIDERS
# ============================================
WHISPER_API_KEY=
ELEVENLABS_API_KEY=
GTTS_ENABLED=true

# ============================================
# APPLICATION CONFIGURATION
# ============================================
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-secure-random-string

# ============================================
# RATE LIMITS & QUOTAS
# ============================================
MAX_MESSAGES_PER_MINUTE=20
MAX_MESSAGES_PER_HOUR=500
MAX_IMAGE_SIZE_MB=10
MAX_VOICE_DURATION_SECONDS=120
MAX_CONVERSATION_HISTORY=100

# ============================================
# CORS & SECURITY
# ============================================
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000
API_RATE_LIMIT=100

# ============================================
# STREAMLIT DASHBOARD
# ============================================
STREAMLIT_PORT=8501
STREAMLIT_SECRET_KEY=change-this-to-a-secure-random-string
ENABLE_STREAMLIT=true

# ============================================
# DEPLOYMENT
# ============================================
DEPLOYMENT_TARGET=docker
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=genesis-protocol
DOCKER_IMAGE_TAG=latest