# Hugging Face Spaces - Docker SDK deployment for Genesis Protocol
# Runs web server + Telegram bot + auto-updater together via supervisord
# Full power (same as Railway), lifetime free on HF Spaces

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt ./requirements.txt
COPY web/requirements.txt ./web/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir -r web/requirements.txt

# Copy application code
COPY genesis_protocol/ ./genesis_protocol/
COPY web/ ./web/
COPY *.py ./
COPY supervisord.hf.conf ./
COPY scripts/ ./scripts/

# HF Spaces runs as a non-root user (uid 1000). Match permissions.
RUN useradd -m -u 1000 user \
    && mkdir -p /app/data /tmp/logs \
    && chown -R user:user /app /tmp/logs

ENV PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    FLASK_APP=web/app.py \
    PORT=7860 \
    HOME=/home/user \
    SPACE_ID=genesis-protocol

USER user

# HF Spaces expects the app on port 7860
EXPOSE 7860

CMD ["supervisord", "-c", "/app/supervisord.hf.conf"]
